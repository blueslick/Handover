{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handover/compiled.schema.json",
  "title": "Compiled record (also used for answer keys and baseline records)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "patient_id", "run_id", "built_from", "facts"],
  "properties": {
    "format_version": {"const": "1.0"},
    "kind": {"enum": ["compiled", "answer_key", "baseline_keyword", "baseline_medspacy", "baseline_rules_row"]},
    "patient_id": {"$ref": "#/$defs/patient_id"},
    "run_id": {"type": ["string", "null"], "description": "Run folder name under outputs/. null for answer keys and the hand-written sample"},
    "built_from": {"type": "array", "items": {"$ref": "#/$defs/file_name"}, "minItems": 1},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
  },
  "$defs": {
    "patient_id": {"type": "string", "pattern": "^[PRD]\\d{3}$"},
    "hospital": {"enum": ["A", "B", "C"]},
    "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "file_name": {"type": "string", "pattern": "^[PRD]\\d{3}_[ABC]\\.(csv|txt)$"},
    "dose": {"type": ["string", "null"], "pattern": "^\\d+(\\.\\d+)? (mg|mcg|g|mL|units|puffs|drops)$"},
    "frequency": {"enum": [null, "once", "daily", "twice_daily", "three_times_daily", "four_times_daily", "at_night", "weekly", "as_needed", "other"]},
    "status": {"enum": ["current", "stopped", "none_recorded", "suspected", "family_history", "planned", "side_effect"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hospital", "date", "quote", "file"],
      "properties": {
        "hospital": {"$ref": "#/$defs/hospital"},
        "date": {"$ref": "#/$defs/date"},
        "quote": {"type": ["string", "null"]},
        "file": {"$ref": "#/$defs/file_name"}
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dose", "frequency", "hospital", "date", "quote"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "dose": {"$ref": "#/$defs/dose"},
        "frequency": {"$ref": "#/$defs/frequency"},
        "hospital": {"$ref": "#/$defs/hospital"},
        "date": {"$ref": "#/$defs/date"},
        "quote": {"type": ["string", "null"]}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "patient_id", "type", "name", "name_as_written", "dose", "frequency", "reaction", "status", "hospital", "date", "quote", "sources", "history", "flags", "conflict_group"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^[PRD]\\d{3}-F\\d{2,3}$"},
        "patient_id": {"$ref": "#/$defs/patient_id"},
        "type": {"enum": ["allergy", "medicine", "diagnosis", "operation"]},
        "name": {"type": ["string", "null"], "description": "Generic name, lowercase. null only when status is none_recorded"},
        "name_as_written": {"type": ["string", "null"]},
        "dose": {"$ref": "#/$defs/dose"},
        "frequency": {"$ref": "#/$defs/frequency"},
        "reaction": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "hospital": {"$ref": "#/$defs/hospital"},
        "date": {"$ref": "#/$defs/date"},
        "quote": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
        "history": {"type": "array", "items": {"$ref": "#/$defs/history_entry"}},
        "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["unverified", "conflict", "missing_dose", "possible_missed", "dose_changed", "unknown_name"]}},
        "conflict_group": {"type": ["string", "null"], "pattern": "^[PRD]\\d{3}-C\\d{1,2}$"}
      }
    }
  }
}
